#!/bin/zsh
# Builds Merum.app in this folder from shared/ (the core, shared with the iPhone app) and mac/, with plain swiftc and no
# Xcode project (dev/apps.md, «Common to every app»).
# Works with the Command Line Tools alone for an ad hoc local build (no Assets.car: the icon is packed by iconutil);
# full Xcode in /Applications is used for the icon (actool, Icon Composer) and is required for a Developer ID build.
# SIGN_ID="Developer ID Application: …" ./build signs with that certificate; ad hoc otherwise. Signed by the team that
# owns the iCloud container (and with Merum.provisionprofile beside this script), the app carries iCloud; built by
# anyone else it simply keeps its notes on that Mac.
set -e
cd "${0:A:h}"
# The version changes per release, not per build (dev/apps.md, «Version numbers»).
name=Merum version=0.3 min=13.0
id=com.geragaraza.${(L)name} app=$name.app team=4PWXU4KC48
# A test copy beside the real one (TEST=1, ad hoc only): its own id and name, so it shares no settings with an installed
# Merum, runs while it runs, and never syncs.
[ -n "${TEST:-}" ] && { id=$id.test; app="$name Test.app"; }
xc=${XCODE_CONTENTS:-/Applications/Xcode.app/Contents}
has_xcode=0; [ -d "$xc/Developer" ] && [ -x "$xc/Applications/Icon Composer.app/Contents/Executables/ictool" ] && has_xcode=1
if [ -n "${SIGN_ID:-}" ] && [ "$SIGN_ID" != - ] && [ $has_xcode -eq 0 ]; then
  echo "Developer ID builds require full Xcode at $xc (for Assets.car)"; exit 1
fi
tmp=$(mktemp -d); trap 'rm -rf $tmp' EXIT
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$app/Contents/Frameworks"

# Updates: Sparkle, from its release, checked against a pinned checksum; vendor/ keeps it between builds and is checked
# at every build (its whole tree must hash to what the pinned download unpacks to), because whatever lies there is
# signed with our Developer ID. Only what a non-sandboxed app runs goes into the bundle: no XPC services, no headers,
# Apple silicon only.
sparkle=2.10.1 sparkle_sha=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
sparkle_tree=ae96790e4863ed4a925dd814181556c0d896938b30e40e3299a33499bd89e57c
treesha() { (cd "$1" && find . \( -type f -o -type l \) | LC_ALL=C sort | while IFS= read -r f; do
  if [ -L "$f" ]; then echo "l $(readlink "$f") $f"; else echo "f $(shasum -a 256 < "$f" | cut -c1-64) $f"; fi
done) | shasum -a 256 | cut -c1-64; }
if [ ! -d vendor/Sparkle.framework ]; then
  mkdir -p vendor $tmp/sparkle
  curl -fsSL -o $tmp/sparkle.tar.xz https://github.com/sparkle-project/Sparkle/releases/download/$sparkle/Sparkle-$sparkle.tar.xz
  [ "$(shasum -a 256 $tmp/sparkle.tar.xz | cut -d' ' -f1)" = $sparkle_sha ] || { echo "Sparkle checksum mismatch"; exit 1; }
  tar -xf $tmp/sparkle.tar.xz -C $tmp/sparkle Sparkle.framework
  ditto $tmp/sparkle/Sparkle.framework vendor/Sparkle.framework
fi
[ "$(treesha vendor/Sparkle.framework)" = $sparkle_tree ] || { echo "vendor/Sparkle.framework is not what the pinned download unpacks to: delete it and build again"; exit 1; }
sp=$app/Contents/Frameworks/Sparkle.framework
ditto vendor/Sparkle.framework "$sp"
rm -rf "$sp"/{XPCServices,Headers,PrivateHeaders,Modules} "$sp"/Versions/B/{XPCServices,Headers,PrivateHeaders,Modules}
for b in Sparkle Autoupdate Updater.app/Contents/MacOS/Updater; do
  lipo "$sp/Versions/B/$b" -thin arm64 -output $tmp/thin && cp $tmp/thin "$sp/Versions/B/$b"
done

# The core and the Mac app. Trials (mac/trial.swift: scripted checks with --data and --trial) only in an ad hoc build.
# FORCE_TRIALS=1 adds them to a signed build too, for a check of iCloud by script; such a build is never released.
[ "${SIGN_ID:--}" = - ] || [ -n "${FORCE_TRIALS:-}" ] && trials=(-D TRIALS) || trials=()
sources=(shared/*.swift mac/*.swift)
sources=(${sources:#mac/icon.swift})
# An explicit minimum: by default swiftc targets this Mac's macOS and every older system refuses the result.
swiftc -O -wmo -target arm64-apple-macos$min -module-name $name $trials -F vendor -framework Sparkle \
  -licucore -Xlinker -rpath -Xlinker @executable_path/../Frameworks -o "$app/Contents/MacOS/$name" $sources

# App icon, Apple's way (dev/apps.md, «Icons, light and dark»): mac/icon.swift writes the whole Icon Composer document
# (the picture, the system's own fill as the plate, glass, shadow and translucency off, and the tinted entry without
# which the word nearly vanishes in Clear and Tinted), Xcode's actool compiles it into Assets.car (macOS 26+ show it
# light, dark, clear or tinted with the theme) and AppIcon.icns (Apple's light rendition, macOS 13-15).
# docs/icon.png and docs/icon-dark.png are Icon Composer's own renders (ictool), 206 px on a 256 canvas as Apple's 824
# of 1024. Without Xcode, AppIcon.icns is packed from the light picture by sips + iconutil (no dark rendition) and
# docs/ is left as it is.
swiftc -O -o $tmp/icon mac/icon.swift
if [ $has_xcode -eq 1 ]; then
  $tmp/icon --document $tmp/AppIcon.icon
  DEVELOPER_DIR=$xc/Developer xcrun actool $tmp/AppIcon.icon --compile "$PWD/$app/Contents/Resources" --platform macosx \
    --minimum-deployment-target $min --app-icon AppIcon --output-partial-info-plist $tmp/icon.plist --target-device mac >/dev/null
  mkdir -p docs
  for r in Default Dark; do
    "$xc/Applications/Icon Composer.app/Contents/Executables/ictool" $tmp/AppIcon.icon --export-image --output-file $tmp/$r.png \
      --platform macOS --rendition $r --width 206 --height 206 --scale 1 >/dev/null
    sips -p 256 256 $tmp/$r.png --out docs/icon${${r:#Default}:+-dark}.png >/dev/null
  done
else
  echo "Note: Xcode not found at $xc; AppIcon.icns from the light picture (iconutil), no dark rendition."
  mkdir -p $tmp/pictures $tmp/AppIcon.iconset
  $tmp/icon $tmp/pictures
  for sz in 16 32 128 256 512; do
    sips -z $sz $sz $tmp/pictures/light.png --out $tmp/AppIcon.iconset/icon_${sz}x${sz}.png >/dev/null
    sips -z $((sz*2)) $((sz*2)) $tmp/pictures/light.png --out $tmp/AppIcon.iconset/icon_${sz}x${sz}@2x.png >/dev/null
  done
  iconutil -c icns $tmp/AppIcon.iconset -o "$app/Contents/Resources/AppIcon.icns"
fi

# LSUIElement: the app starts with no Dock icon and no menu bar; it becomes a regular app only while its window shows.
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>$id</string>
<key>CFBundleName</key><string>$name</string>
<key>CFBundleDisplayName</key><string>${app%.app}</string>
<key>CFBundleExecutable</key><string>$name</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string></array>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$version</string>
<key>CFBundleVersion</key><string>$version</string>
<key>NSHumanReadableCopyright</key><string>Herman Harazha</string>
<key>LSUIElement</key><true/>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>LSMinimumSystemVersion</key><string>$min</string>
<key>NSQuitAlwaysKeepsWindows</key><false/>
<key>SUFeedURL</key><string>https://github.com/geragarazagh/${(L)name}/releases/latest/download/appcast.xml</string>
<key>SUPublicEDKey</key><string>URlTczL/bZGecdDnRO3qHJgOYtOCe5FOPhKetm3FNqY=</string>
<key>SURequireSignedFeed</key><true/>
<key>SUVerifyUpdateBeforeExtraction</key><true/>
<key>SUEnableAutomaticChecks</key><true/>
<key>SUAllowsAutomaticUpdates</key><false/>
</dict></plist>
PLIST

# English only (dev/rules.md, section 3): the text is in the code, and en.lproj alone makes the system's own parts
# (the app menu's Services, the About panel) English too.
mkdir "$app/Contents/Resources/en.lproj"
for f in LICENSE THIRD-PARTY-LICENSES.md; do [ -f $f ] && cp $f "$app/Contents/Resources/"; done
[ -f skills/merum/SKILL.md ] && cp skills/merum/SKILL.md "$app/Contents/Resources/SKILL.md"

# Open at Login (dev/apps.md, «Open at Login»): an agent in the bundle passes --login; that copy only starts the app
# with `open -g … --background` and exits, so a login start shows no window and unregistering never kills the app.
mkdir -p "$app/Contents/Library/LaunchAgents"
cat > "$app/Contents/Library/LaunchAgents/$id.login.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$id.login</string>
<key>BundleProgram</key><string>Contents/MacOS/$name</string>
<key>ProgramArguments</key><array><string>Contents/MacOS/$name</string><string>--login</string></array>
<key>AssociatedBundleIdentifiers</key><array><string>$id</string></array>
<key>RunAtLoad</key><true/>
<key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
PLIST

# iCloud (CloudKit for the notes, silent pushes for changes, the key-value store for sort and text size) is a set of
# restricted entitlements: only a build signed by the team that owns the container carries them, together with the
# team's Developer ID provisioning profile for this bundle id (Contents/embedded.provisionprofile; made once with
# Xcode, kept beside this script, out of git; dev/release.md, «iCloud in a Developer ID app»). A Developer ID app
# talks to CloudKit's production environment, so it says so.
cloud=
if [[ "${SIGN_ID:-}" == *"($team)"* ]]; then
  [ -f $name.provisionprofile ] || { echo "$name.provisionprofile missing: a signed build without it would not sync"; exit 1; }
  cp $name.provisionprofile "$app/Contents/embedded.provisionprofile"
  cloud="<key>com.apple.application-identifier</key><string>$team.$id</string>
<key>com.apple.developer.team-identifier</key><string>$team</string>
<key>com.apple.developer.icloud-container-identifiers</key><array><string>iCloud.$id</string></array>
<key>com.apple.developer.icloud-services</key><array><string>CloudKit</string></array>
<key>com.apple.developer.icloud-container-environment</key><string>Production</string>
<key>com.apple.developer.aps-environment</key><string>production</string>
<key>com.apple.developer.ubiquity-kvstore-identifier</key><string>$team.$id</string>"
else
  echo "Note: not signed by team $team: built without iCloud (the notes stay on this Mac)."
fi
cat > $tmp/e.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
$cloud
$([ "${SIGN_ID:--}" = - ] && echo '<key>com.apple.security.cs.disable-library-validation</key><true/>')
</dict></plist>
PLIST

# Hardened runtime and a timestamp, as notarisation asks. Sparkle's parts are signed inside out, without --deep
# (Sparkle's own instructions). An ad hoc build has no team, so dyld refuses the framework under library validation;
# only that build turns it off.
sign=${SIGN_ID:--}; stamp=(); [ "$sign" = - ] || stamp=(--timestamp)
for p in "$sp/Versions/B/Autoupdate" "$sp/Versions/B/Updater.app" "$sp"; do codesign -f -s "$sign" $stamp --options runtime "$p"; done
codesign -f -s "$sign" $stamp --options runtime --entitlements $tmp/e.plist --identifier $id "$app"
echo Done
